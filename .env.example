APP_NAME=enterprise-rag-api
APP_ENV=development
LOG_LEVEL=INFO

# Async SQLAlchemy DSN (API layer)
DATABASE_URL=postgresql+asyncpg://rag:rag@localhost:5432/enterprise_rag
# Sync DSN used by Celery workers
DATABASE_SYNC_URL=postgresql+psycopg://rag:rag@localhost:5432/enterprise_rag

REDIS_URL=redis://localhost:6379/0

EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384

# mock | llama_cpp
LLM_BACKEND=mock
LLAMA_MODEL_PATH=
LLAMA_N_CTX=2048
LLAMA_N_GPU_LAYERS=0

CHUNK_SIZE=1000
CHUNK_OVERLAP=200
RETRIEVAL_TOP_K=5
UPLOAD_DIR=data/uploads
